# Public site URL used in invite links.
APP_URL=http://localhost:3000

# Required in production. Any long random string.
SESSION_SECRET=

# Firebase web config. These values are public by design (the browser needs them for Google sign-in).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin, only when TaskOrbit data should live in Firestore.
# Paste the service account JSON as one line, or point at the downloaded file. Never commit the real file.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Named Firestore database. Leave empty to use (default), which is what TaskOrbit uses on gocorona-52deb.
FIRESTORE_DATABASE_ID=
